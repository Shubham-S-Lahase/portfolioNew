# Groq — FREE open-source models (Llama), no credit card
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Optional (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.1-8b-instant

# Private assistant easter egg (server-only, never commit real values)
# Generate: node scripts/encrypt-amreen-poem.mjs path/to/poem.txt
# AMREEN_SECRET_KEY=
# AMREEN_SECRET_PAYLOAD=
# AMREEN_BACKDROP_PAYLOAD=  # encrypt backdrop line with same key (see scripts/encrypt-amreen-poem.mjs)
